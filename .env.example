# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE
# Copy this file to .env and fill in your actual values.
# NEVER commit .env or any file containing real credentials.
# =============================================================================

# --- Supabase ---
# Found in: Supabase Dashboard → Project Settings → API
# The anon key is safe to use in client code IF Row Level Security is enabled.
REACT_APP_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
REACT_APP_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# --- Backend ---
# Development: http://localhost:3001
# Production:  https://trust-school-backend.onrender.com
#
# ⚠️  CRITICAL FOR PRODUCTION — this is a BUILD-TIME variable.
#     Create React App inlines every REACT_APP_* value into the bundle at build
#     time. It is NOT read at runtime, so:
#
#       1. It must be set in Vercel → Settings → Environment Variables, scoped to
#          Production (and Preview, if previews should reach the backend).
#       2. Changing it in Vercel does NOT update existing deployments. You must
#          REDEPLOY for a new value to take effect.
#       3. If it is missing, src/utils/apiClient.js:3 silently falls back to
#          http://localhost:3001. On an HTTPS page the browser then blocks every
#          request as mixed content and the entire API layer fails — with no
#          server-side error to point at.
#
#     Must match the `name:` of the Render service in render.yaml.
REACT_APP_BACKEND_URL=http://localhost:3001

# --- Firebase ---
# Found in: Firebase Console → Project Settings → Your apps → Web app → SDK snippet
# The API key is a public client identifier. Protect it by adding domain restrictions
# in Google Cloud Console → APIs & Services → Credentials.
REACT_APP_FIREBASE_API_KEY=your_firebase_api_key_here
REACT_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
REACT_APP_FIREBASE_PROJECT_ID=your-project-id
REACT_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
REACT_APP_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
REACT_APP_FIREBASE_APP_ID=1:your_sender_id:web:your_app_id
REACT_APP_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX
