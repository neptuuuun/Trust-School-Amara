# Server
PORT=3001

# ── Chargily Pay ──────────────────────────────────────────────────────────────
# Obtain from: https://pay.chargily.net/  (Dashboard → Developers → API Keys)
# PRODUCTION RUNS IN LIVE MODE — use the live_pk_/live_sk_ pair here, never test_.
# NOTE: v2 has SEPARATE endpoints per mode and the backend picks the right one
#   from the key prefix (test_sk_ → https://pay.chargily.net/test/api/v2,
#   live_sk_ → https://pay.chargily.net/api/v2). A test key on the live endpoint
#   returns 401 "Unauthenticated." Set CHARGILY_DEBUG=1 to log requests/responses.
# Never commit the real secret — this file is tracked by git. Put the real live
# values in backend/.env (gitignored) and in the Render dashboard env vars.
CHARGILY_PUBLIC_KEY=live_pk_your_live_public_key_here
CHARGILY_SECRET_KEY=live_sk_your_live_secret_key_here

# ════════════════════════════════════════════════════════════════════════════
#  PRODUCTION VALUES FOR THE THREE URL VARIABLES BELOW ARE DECLARED IN
#  ../render.yaml — that Blueprint is the source of truth for the deployed
#  backend. The values in this template are LOCAL DEVELOPMENT defaults.
#  Production:
#    BACKEND_URL     = https://trust-school-backend.onrender.com
#    FRONTEND_URL    = https://trustschoolamara.com
#    ALLOWED_ORIGINS = https://trustschoolamara.com,https://www.trustschoolamara.com
# ════════════════════════════════════════════════════════════════════════════

# Public URL of this backend (used to register the Chargily webhook endpoint).
# Leave blank ONLY for local dev — there is no publicly reachable URL for a
# laptop, so payment confirmation falls back to POST /api/chargily/verify/:orderId.
# In production this MUST be set: if it is blank, no webhook_endpoint is attached
# to any checkout, and a student who closes the tab after paying is never enrolled.
BACKEND_URL=

# Public URL of the React frontend (used in Chargily success/failure redirect URLs).
# If this is left at localhost in production, Chargily redirects real payers to a
# dead page after a successful charge.
FRONTEND_URL=http://localhost:3000

# CORS — comma-separated list of allowed frontend origins (exact match, no wildcards).
# server.js rejects any origin not in this list, so a missing production domain
# here breaks every browser API call from the live site.
# Vercel PREVIEW deployments get a unique hostname per deploy and will fail CORS
# against production — that is the safe default. Append a specific preview URL only
# when you deliberately need it; never use a wildcard.
ALLOWED_ORIGINS=http://localhost:3000

# Firebase credentials — choose ONE option:
#
# Option A (local dev): path to a service-account JSON file OUTSIDE the project directory.
#   IMPORTANT: Never store the key inside the project folder — it could be accidentally
#   committed or exposed if the folder is shared/synced.
#   Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
#   Store at: C:\Users\PC\trust-school-serviceAccount.json  (or similar, outside project)
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\PC\trust-school-serviceAccount.json
#
# Option B (cloud / Railway / Render — RECOMMENDED for production):
#   base64-encode the JSON file and set it as an environment secret in your host.
#   Windows PS: [Convert]::ToBase64String([IO.File]::ReadAllBytes('path\to\key.json')) | clip
#   Mac/Linux:  base64 -i path/to/key.json | tr -d '\n' | pbcopy
# FIREBASE_SERVICE_ACCOUNT_BASE64=<paste base64 string here>

# Firebase project ID (only needed when using Option B or ADC without a project set)
FIREBASE_PROJECT_ID=trust-school

# ════════════════════════════════════════════════════════════════════════════
#  SUPABASE STORAGE  (server-side cleanup of student ID/photo files)
# ════════════════════════════════════════════════════════════════════════════
# When a student is deleted, the backend removes their files from the
# `user-uploads` bucket so no ID scan is left behind (services/supabaseStorage.js).
# Use the SERVICE-ROLE key here — NEVER the anon key, and never expose it to the
# browser. Leave BOTH blank to disable server-side cleanup (the frontend's
# best-effort cleanup still runs as a fallback).
#   Supabase dashboard → Project Settings → API → Project URL / service_role key
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ════════════════════════════════════════════════════════════════════════════
#  EMAIL / DELIVERABILITY  (see EMAIL_DELIVERABILITY_REPORT.md)
# ════════════════════════════════════════════════════════════════════════════
# Leave SMTP_HOST blank to disable email notifications.
#
# ⚠️  DO NOT send from a free @gmail.com / @outlook.com account. It is the #1
#     reason mail lands in spam and can never be authenticated for your brand.
#     Use a transactional provider (Brevo / Resend / SendGrid) on a domain you
#     own, and add the SPF + DKIM + DMARC DNS records (see the report).
#
# ── Recommended: generic SMTP (works with ANY provider) ──────────────────────
# Example values for Brevo (free 300 emails/day):
#   SMTP_HOST=smtp-relay.brevo.com
#   SMTP_PORT=587
#   SMTP_USER=<your Brevo SMTP login>
#   SMTP_PASSWORD=<your Brevo SMTP key>
# Example values for Resend:
#   SMTP_HOST=smtp.resend.com
#   SMTP_PORT=465
#   SMTP_USER=resend
#   SMTP_PASSWORD=<your Resend API key>
SMTP_HOST=
SMTP_PORT=587
# SMTP_SECURE=false      # true only for port 465 (implicit TLS); omit for 587/STARTTLS
SMTP_USER=
SMTP_PASSWORD=

# ── Sender identity (decoupled from the SMTP login on purpose) ────────────────
# MAIL_FROM_ADDRESS MUST be on the domain you authenticate with SPF/DKIM/DMARC.
MAIL_FROM_ADDRESS=noreply@yourschooldomain.com
MAIL_FROM_NAME=Trust School Amara
# A real, monitored inbox where student replies should land:
MAIL_REPLY_TO=contact@yourschooldomain.com
# Shown in the footer + used for the List-Unsubscribe mailto:
MAIL_SUPPORT_EMAIL=contact@yourschooldomain.com
# Organisation identity printed in every email footer (CAN-SPAM / trust signal):
MAIL_ORG_ADDRESS=بومرداس / برج منايل، الجزائر
MAIL_ORG_PHONE=0554 56 29 97
# Only set when sending through YOUR OWN domain SMTP (aligns Return-Path for SPF).
# Leave UNSET when using a managed ESP (Brevo/Resend/SendGrid manage Return-Path).
# MAIL_RETURN_PATH=bounces@yourschooldomain.com

# ── Legacy consumer transport (DISCOURAGED — only used if SMTP_HOST is blank) ──
# Kept for backwards-compatibility. Mail sent this way will likely be filtered.
#   https://support.google.com/accounts/answer/185833
# EMAIL_SERVICE=gmail
# EMAIL_USER=your-email@gmail.com
# EMAIL_PASSWORD=your-app-password

# URL shown in email footers / buttons.
# Production value is declared in ../render.yaml: https://trustschoolamara.com
# (the old trust-school.web.app Firebase Hosting URL is retired).
WEBSITE_URL=http://localhost:3000

# ── Testing only ─────────────────────────────────────────────────────────────
# Override the support-lesson subscription duration for rapid expiry testing.
# Set to a positive integer (minutes). Leave unset (or 0) for production (30 days).
# Example: SUPPORT_LESSON_EXPIRY_MINUTES=2  → subscription expires in 2 minutes.
# NEVER set this in production — it will shorten all student subscriptions.
# SUPPORT_LESSON_EXPIRY_MINUTES=
