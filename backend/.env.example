# Server
PORT=3001

# CORS — comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:3000,https://your-app.vercel.app

# Firebase credentials — choose ONE option:
#
# Option A (local dev): path to a service-account JSON file OUTSIDE the project directory.
#   IMPORTANT: Never store the key inside the project folder — it could be accidentally
#   committed or exposed if the folder is shared/synced.
#   Download from: Firebase Console → Project Settings → Service accounts → Generate new private key
#   Store at: C:\Users\PC\trust-school-serviceAccount.json  (or similar, outside project)
GOOGLE_APPLICATION_CREDENTIALS=C:\Users\PC\trust-school-serviceAccount.json
#
# Option B (cloud / Railway / Render — RECOMMENDED for production):
#   base64-encode the JSON file and set it as an environment secret in your host.
#   Windows PS: [Convert]::ToBase64String([IO.File]::ReadAllBytes('path\to\key.json')) | clip
#   Mac/Linux:  base64 -i path/to/key.json | tr -d '\n' | pbcopy
# FIREBASE_SERVICE_ACCOUNT_BASE64=<paste base64 string here>

# Firebase project ID (only needed when using Option B or ADC without a project set)
FIREBASE_PROJECT_ID=trust-school

# Email (nodemailer) — leave blank to disable email notifications
# For Gmail you must create an App Password (2FA required):
#   https://support.google.com/accounts/answer/185833
EMAIL_SERVICE=gmail
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password

# URL shown in email footers / buttons
WEBSITE_URL=https://trust-school.web.app

# ── Testing only ─────────────────────────────────────────────────────────────
# Override the support-lesson subscription duration for rapid expiry testing.
# Set to a positive integer (minutes). Leave unset (or 0) for production (30 days).
# Example: SUPPORT_LESSON_EXPIRY_MINUTES=2  → subscription expires in 2 minutes.
# NEVER set this in production — it will shorten all student subscriptions.
# SUPPORT_LESSON_EXPIRY_MINUTES=
