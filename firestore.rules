rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────

    // The caller's admin document. Firestore caches identical get() calls within a
    // single rule evaluation, so the repeated reads below count as one access.
    function adminDoc() {
      return get(/databases/$(database)/documents/admins/$(request.auth.uid)).data;
    }

    function getAdminBranchId() {
      return adminDoc().branchId;
    }

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    // An admin whose account has not been deactivated. A missing `active` field
    // defaults to true so legacy admin docs (provisioned before this field existed)
    // keep working without a migration. Deactivating an employee (active:false)
    // revokes their Firestore access immediately.
    function isActiveAdmin() {
      return isAdmin() && adminDoc().get('active', true) != false;
    }

    function isBranchAdmin(branchId) {
      return isActiveAdmin() && getAdminBranchId() == branchId;
    }

    // Owner — cross-branch, read-only business-intelligence role. Provisioned ONLY
    // via the Admin SDK (backend script). An owner can READ every branch's data;
    // they never write through client rules — all owner-facing mutations go through
    // the Express backend (Admin SDK), which bypasses these rules entirely.
    function isOwner() {
      return request.auth != null
        && exists(/databases/$(database)/documents/owners/$(request.auth.uid));
    }

    function isAuthenticated() {
      return request.auth != null;
    }

    function isSelf(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ── Capacity guard ────────────────────────────────────────────────────────
    // Returns true when a class still has room (or has no capacity limit).
    // Used on languagesRegistered / trainingsRegistered creates to prevent a
    // client writing directly to Firestore from bypassing the app-level check.
    // No-op when the class document doesn't exist (graceful degradation).
    function classHasCapacity(branchId, classId) {
      let clsPath = /databases/$(database)/documents/branches/$(branchId)/classes/$(classId);
      return !exists(clsPath)
        || get(clsPath).data.get('capacity', 0) == 0
        || get(clsPath).data.enrollmentCount < get(clsPath).data.capacity;
    }

    // ── Privilege / payment integrity guard ───────────────────────────────────
    // Clients may NEVER self-assign a verified/approved/paid/admin state on create.
    // These fields are server-controlled (branch admin / backend Admin SDK) only.
    function noPrivilegedStatus() {
      return (!('verified' in request.resource.data)        || request.resource.data.verified == false)
        && (!('accountVerified' in request.resource.data)   || request.resource.data.accountVerified == false)
        && (!('paymentVerified' in request.resource.data)   || request.resource.data.paymentVerified == false)
        && (!('yearlyFeePaid' in request.resource.data)     || request.resource.data.yearlyFeePaid == false)
        && (!('feePaid' in request.resource.data)           || request.resource.data.feePaid == false)
        && (!('isAdmin' in request.resource.data)           || request.resource.data.isAdmin == false)
        && (!('paymentStatus' in request.resource.data)     || request.resource.data.paymentStatus == 'pending')
        && (!('status' in request.resource.data)
            || !(request.resource.data.status in ['verified', 'approved', 'paid', 'active', 'registered']));
    }

    // Self-update may not change role/isAdmin or any verification/payment flag.
    // The support-level fields (distinguishedSubjectsAverage / supportClassification)
    // are likewise server-controlled: they are written ONLY by the Express backend
    // (Admin SDK) during the support-enrollment flow or by an admin correction, so a
    // student can never tamper with their own classification from the console.
    function isSafeUserSelfUpdate() {
      return !(('role' in request.resource.data) && request.resource.data.role != resource.data.role)
        && !(('isAdmin' in request.resource.data) && request.resource.data.isAdmin != resource.data.isAdmin)
        && !(('studyYear' in request.resource.data) && request.resource.data.studyYear != resource.data.studyYear && resource.data.studyYear != null)
        && !(('schoolLevel' in request.resource.data) && request.resource.data.schoolLevel != resource.data.schoolLevel && resource.data.schoolLevel != null)
        && !(('yearlyFeePaid' in request.resource.data) && request.resource.data.yearlyFeePaid != resource.data.yearlyFeePaid)
        && !(('paymentVerified' in request.resource.data) && request.resource.data.paymentVerified != resource.data.paymentVerified)
        && !(('accountVerified' in request.resource.data) && request.resource.data.accountVerified != resource.data.accountVerified)
        && !(('verified' in request.resource.data) && request.resource.data.verified != resource.data.verified)
        && !(('verificationStatus' in request.resource.data) && request.resource.data.verificationStatus != resource.data.verificationStatus)
        && !(('distinguishedSubjectsAverage' in request.resource.data) && request.resource.data.distinguishedSubjectsAverage != resource.data.get('distinguishedSubjectsAverage', null))
        && !(('supportClassification' in request.resource.data) && request.resource.data.supportClassification != resource.data.get('supportClassification', null))
        // Educational institution is REQUIRED: a self-update may CHANGE it but never
        // clear it to an empty/non-string value. Deny only when school is actually
        // changed to something invalid — an unchanged value (incl. a stub's null that
        // is filled via isCompletingRegistration) still passes, as do edits that don't
        // touch school at all.
        && !(('school' in request.resource.data)
             && request.resource.data.school != resource.data.get('school', null)
             && !(request.resource.data.school is string && request.resource.data.school.size() > 0));
    }

    // Self-registration: a brand-new user may ONLY create a 'student' profile with
    // every privileged/verification flag in its safe default state. Admin-created
    // students are written by the backend Admin SDK and bypass these rules.
    function isSafeUserCreate(userId) {
      return isSelf(userId)
        && request.resource.data.role == 'student'
        && (!('isAdmin' in request.resource.data)           || request.resource.data.isAdmin == false)
        && (!('verified' in request.resource.data)          || request.resource.data.verified == false)
        && (!('accountVerified' in request.resource.data)   || request.resource.data.accountVerified == false)
        && (!('paymentVerified' in request.resource.data)   || request.resource.data.paymentVerified == false)
        && (!('yearlyFeePaid' in request.resource.data)     || request.resource.data.yearlyFeePaid == false)
        && request.resource.data.get('verificationStatus', 'unverified') in ['unverified', 'pending']
        // Educational institution is REQUIRED on every COMPLETED person record.
        // Incomplete Google stubs (completedProfile:false) are exempt here — they
        // collect it later at /complete-registration (see isCompletingRegistration).
        && (request.resource.data.get('completedProfile', true) == false
            || (request.resource.data.school is string && request.resource.data.school.size() > 0));
    }

    // Allows the one-way registration-completion transition only:
    //   completedProfile: false → true
    //   verificationStatus: 'unverified' → 'pending'
    // Cannot be used to self-promote to 'verified' or re-open a pending account.
    function isCompletingRegistration() {
      return resource.data.get('completedProfile', false) == false
        && request.resource.data.completedProfile == true
        && resource.data.get('verificationStatus', 'unverified') == 'unverified'
        && request.resource.data.verificationStatus == 'pending'
        // Educational institution becomes REQUIRED at completion — the stub had none.
        && request.resource.data.school is string && request.resource.data.school.size() > 0
        // The completion transition must not smuggle in any privilege/payment escalation.
        && !(('role' in request.resource.data) && request.resource.data.role != resource.data.role)
        && !(('isAdmin' in request.resource.data) && request.resource.data.isAdmin != resource.data.isAdmin)
        && !(('yearlyFeePaid' in request.resource.data) && request.resource.data.yearlyFeePaid != resource.data.yearlyFeePaid)
        && !(('paymentVerified' in request.resource.data) && request.resource.data.paymentVerified != resource.data.paymentVerified)
        && !(('accountVerified' in request.resource.data) && request.resource.data.accountVerified != resource.data.accountVerified)
        && !(('verified' in request.resource.data) && request.resource.data.verified != resource.data.verified);
    }

    // Allows a student with a verified email to submit (or resubmit) verification
    // documents. The only locked field changing is verificationStatus
    // ('unverified'|'rejected' → 'pending'). Presence of 'verificationRequest'
    // in the incoming data proves an actual upload event occurred.
    function isSubmittingVerificationRequest() {
      return request.auth.token.email_verified == true
        && resource.data.get('verificationStatus', 'unverified') in ['unverified', 'rejected']
        && request.resource.data.verificationStatus == 'pending'
        && ('verificationRequest' in request.resource.data)
        && !(('role' in request.resource.data)            && request.resource.data.role != resource.data.role)
        && !(('isAdmin' in request.resource.data)         && request.resource.data.isAdmin != resource.data.isAdmin)
        && !(('verified' in request.resource.data)        && request.resource.data.verified == true)
        && !(('accountVerified' in request.resource.data) && request.resource.data.accountVerified == true)
        && !(('paymentVerified' in request.resource.data) && request.resource.data.paymentVerified == true)
        && !(('yearlyFeePaid' in request.resource.data)   && request.resource.data.yearlyFeePaid == true);
    }

    // ── Admins collection ─────────────────────────────────────────────────────
    // CRITICAL: admin documents are provisioned ONLY via the Admin SDK (backend
    // script) or the Firebase Console. NO client may ever write here — a client
    // write would be an instant privilege escalation to global admin.
    match /admins/{uid} {
      // Owner may read the admin registry (admin-performance reporting).
      allow read:  if isSelf(uid) || isOwner();
      allow write: if false;
    }

    // ── Owners collection ─────────────────────────────────────────────────────
    // CRITICAL: owner documents are provisioned ONLY via the Admin SDK (backend
    // script `provision-owner.js`) or the Firebase Console. NO client may write —
    // a client write would be an instant privilege escalation to global owner.
    match /owners/{uid} {
      allow read:  if isSelf(uid) || isOwner();
      allow write: if false;
    }

    // ── Payment orders ────────────────────────────────────────────────────────
    // Written only by the Express backend (Admin SDK).
    // Students may read their own orders; admins/owners may read all in their branch.
    // No client may create, update, or delete — all mutations go through the backend.
    match /paymentOrders/{orderId} {
      allow read: if isAuthenticated() && (
        resource.data.studentId == request.auth.uid
        || isOwner()
        || (isActiveAdmin() && resource.data.branchId == getAdminBranchId())
      );
      allow create, update, delete: if false;
    }

    // ── Financial ledger ──────────────────────────────────────────────────────
    // Append-only, server-authored single source of truth for revenue. Written
    // ONLY by the Express backend (Admin SDK). Entries are IMMUTABLE — corrections
    // append a 'reversal'/'adjustment' entry rather than mutating history.
    //   read  : owner (all branches) or branch admin (own branch only)
    //   create: Admin SDK only (allow ... if false here)
    //   update/delete: NEVER (immutability guarantee)
    match /ledger/{entryId} {
      allow read:   if isOwner() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
      allow create, update, delete: if false;
    }

    // ── Audit log ─────────────────────────────────────────────────────────────
    // Permanent audit trail. Written ONLY by the Express backend (Admin SDK).
    //   read  : owner (all branches) or branch admin (own branch only)
    //   write : Admin SDK only
    match /auditLogs/{logId} {
      allow read:   if isOwner() || (isAuthenticated() && isBranchAdmin(resource.data.branchId));
      allow write:  if false;
    }

    // ── Global financial config (e.g. config/finance.annualFeeAmount) ─────────
    // Owner-controlled policy, broadly READABLE (admins record payments, students
    // self-pay, the backend snapshots the amount). Writes go ONLY through the
    // Express backend (Admin SDK) via the owner endpoints — never a client.
    match /config/{document} {
      allow read:  if true;
      allow write: if false;
    }

    // ── Legacy root users collection ──────────────────────────────────────────
    // Uses isActiveAdmin() (not isAdmin()) so a deactivated admin loses access
    // here too. Left un-branch-scoped because these legacy docs predate the
    // multi-branch model and may carry no branchId; the live model is
    // /branches/{branchId}/users (already branch-scoped).
    match /users/{userId} {
      allow read:   if isActiveAdmin() || isSelf(userId);
      allow create: if isActiveAdmin() || isSafeUserCreate(userId);
      allow update: if isActiveAdmin() || (isSelf(userId) && isSafeUserSelfUpdate());
      allow delete: if isActiveAdmin();
    }

    // ── Global support lesson registrations ───────────────────────────────────
    // Written only by the Express backend (Admin SDK); clients may only read.
    // Admin read is BRANCH-SCOPED (isBranchAdmin folds in the active-admin check),
    // so a branch admin can never read another branch's registrations and a
    // deactivated admin loses access immediately. Owner is cross-branch read-only.
    match /supportLessonRegistrations/{registrationId} {
      allow read: if isOwner()
        || isBranchAdmin(resource.data.branchId)
        || (isAuthenticated() && resource.data.userId == request.auth.uid);
      allow create, update, delete: if false;
    }

    // ── In-app notifications ──────────────────────────────────────────────────
    match /notifications/{notificationId} {
      allow read: if isAuthenticated()
        && (resource.data.target == 'all' || resource.data.target == request.auth.uid);
      allow write: if false;
    }

    // ── Branches ──────────────────────────────────────────────────────────────
    match /branches/{branchId} {
      // Branch documents are public — required for the branch selection page
      // and for BranchContext to populate the branches list.
      allow read: if true;
      allow write: if isBranchAdmin(branchId);

      // Student profiles — admin sees all in their branch; students see only themselves.
      // Self-create is locked to a safe 'student' profile: no role/isAdmin/verified
      // injection. Admin-created students go through the Express backend (Admin SDK),
      // which bypasses these rules, so pre-verified enrollment is unaffected.
      match /users/{uid} {
        allow read:   if isBranchAdmin(branchId) || isSelf(uid);
        allow create: if isBranchAdmin(branchId) || isSafeUserCreate(uid);
        allow update: if isBranchAdmin(branchId)
          || (isSelf(uid) && isSafeUserSelfUpdate())
          || (isSelf(uid) && isCompletingRegistration())
          || (isSelf(uid) && isSubmittingVerificationRequest());
        allow delete: if isBranchAdmin(branchId);
      }

      // Support lessons and courses — public catalog, readable by anyone.
      match /supportLessons/{lessonId} {
        allow read: if true;
        allow create, update, delete: if isBranchAdmin(branchId);
      }

      match /supportCourses/{document} {
        allow read: if true;
        allow write: if isBranchAdmin(branchId);
      }

      // Annual payments — admin sees all; students see their own.
      // Students may ONLY create their own 'pending' payment; verification is
      // server-side (branch admin / backend Admin SDK) via update.
      match /annualPayments/{paymentId} {
        allow read: if isBranchAdmin(branchId)
          || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow create: if isBranchAdmin(branchId)
          || (isAuthenticated()
              && request.resource.data.userId == request.auth.uid
              && request.resource.data.get('status', 'pending') == 'pending');
        allow update, delete: if isBranchAdmin(branchId);
      }

      // Meta — admin only.
      match /meta/{document} {
        allow read, write: if isBranchAdmin(branchId);
      }

      // Languages and trainings — public catalog, readable by anyone.
      match /languages/{document} {
        allow read: if true;
        allow write: if isBranchAdmin(branchId);
      }

      match /trainings/{document} {
        allow read: if true;
        allow write: if isBranchAdmin(branchId);
      }

      // Signups — students create their own (non-privileged); admin manages all.
      // Update is admin-only: a student must not flip their own signup to approved.
      match /signups/{document} {
        allow read: if isBranchAdmin(branchId)
          || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && noPrivilegedStatus();
        allow update, delete: if isBranchAdmin(branchId);
      }

      // Training requests — students submit (non-privileged); admin manages.
      match /trainingRequests/{document} {
        allow read: if isBranchAdmin(branchId)
          || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && noPrivilegedStatus();
        allow update, delete: if isBranchAdmin(branchId);
      }

      // Payments — admin sees all; students see their own. Server-write only.
      match /payments/{document} {
        allow read: if isBranchAdmin(branchId)
          || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow write: if isBranchAdmin(branchId);
      }

      // Annual fees — admin sees all; students see their own. Server-write only.
      match /annualFees/{document} {
        allow read: if isBranchAdmin(branchId)
          || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow write: if isBranchAdmin(branchId);
      }

      // Announcements — any authenticated user reads; only branch admin writes.
      match /announcements/{announcementId} {
        allow read: if isAuthenticated();
        allow create, update, delete: if isBranchAdmin(branchId);
      }

      // Language registration forms — container doc ID IS the student's Firebase UID.
      // Ownership is the path segment {userId}. Entries are created by the owner with
      // a non-privileged status; only the admin may verify them (update/delete).
      match /languagesForms/{userId} {
        allow read, write: if isBranchAdmin(branchId) || isSelf(userId);
        match /languageFormEntries/{entryId} {
          allow read:   if isBranchAdmin(branchId) || isSelf(userId);
          allow create: if isSelf(userId) && noPrivilegedStatus();
          allow update, delete: if isBranchAdmin(branchId);
        }
      }

      // Training registration forms — same path-based pattern as languagesForms.
      match /trainingsForms/{userId} {
        allow read, write: if isBranchAdmin(branchId) || isSelf(userId);
        match /trainingFormEntries/{entryId} {
          allow read:   if isBranchAdmin(branchId) || isSelf(userId);
          allow create: if isSelf(userId) && noPrivilegedStatus();
          allow update, delete: if isBranchAdmin(branchId);
        }
      }

      // Approved language registrations — the "approved" archive is written ONLY
      // by the branch admin during the approval flow. Students never self-approve.
      // create additionally enforces capacity so a direct SDK write cannot
      // exceed the class limit even when the app-layer check is bypassed.
      match /languagesRegistered/{document} {
        allow read: if isBranchAdmin(branchId)
          || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow create: if isBranchAdmin(branchId)
          && (!('classId' in request.resource.data)
              || classHasCapacity(branchId, request.resource.data.classId));
        allow update, delete: if isBranchAdmin(branchId);
      }

      // Approved training registrations — admin-write only (see above).
      // Same capacity gate as languagesRegistered.
      match /trainingsRegistered/{document} {
        allow read: if isBranchAdmin(branchId)
          || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow create: if isBranchAdmin(branchId)
          && (!('classId' in request.resource.data)
              || classHasCapacity(branchId, request.resource.data.classId));
        allow update, delete: if isBranchAdmin(branchId);
      }

      // Support lesson summary records (branches/.../registrations).
      // resource == null check is required because getDoc on a non-existent document
      // sets resource = null in Firestore rules.
      match /registrations/{document} {
        allow read: if isBranchAdmin(branchId)
          || (isAuthenticated() && (resource == null || resource.data.userId == request.auth.uid));
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && noPrivilegedStatus();
        allow update, delete: if isBranchAdmin(branchId);
      }

      // Subjects & Classes (unified academic catalog). Public read; admin write.
      // These blocks MUST precede the catch-all below (they carry no userId).
      match /subjects/{subjectId} {
        allow read: if true;
        allow create, update, delete: if isBranchAdmin(branchId);
      }

      match /classes/{classId} {
        allow read: if true;
        // Classes are created ONLY by the Express backend (Admin SDK), which runs
        // the transactional teacher/classroom conflict check — so every class that
        // exists has been conflict-checked and a client can never inject one.
        allow create: if false;
        // A branch admin may update a class directly ONLY when the schedule-defining
        // fields are unchanged (enrollmentCount bumps, status toggles, subjectName
        // rename cascade). ANY change to schedules / teacherName / classroom is
        // rejected here and must go through the backend transactional endpoint,
        // which enforces conflict detection. This makes it impossible to persist an
        // overlapping teacher or classroom schedule via a direct client write.
        allow update: if isBranchAdmin(branchId)
          && request.resource.data.get('schedules', [])   == resource.data.get('schedules', [])
          && request.resource.data.get('teacherName', '') == resource.data.get('teacherName', '')
          && request.resource.data.get('classroom', '')   == resource.data.get('classroom', '');
        allow delete: if isBranchAdmin(branchId);
      }

      // Teachers catalog — public read (names shown to students), branch-admin write.
      match /teachers/{teacherId} {
        allow read: if true;
        allow create, update, delete: if isBranchAdmin(branchId);
      }

      // Catch-all for any other branch subcollections.
      // Create is restricted to the document owner AND a non-privileged status,
      // preventing injection of admin/verified/paid records into arbitrary paths.
      match /{collection}/{docId} {
        allow read: if isBranchAdmin(branchId)
          || (isAuthenticated() && resource.data.userId == request.auth.uid);
        allow create: if isAuthenticated()
          && request.resource.data.userId == request.auth.uid
          && noPrivilegedStatus();
        allow update, delete: if isBranchAdmin(branchId);

        match /{subcollection}/{subDocId} {
          allow read: if isBranchAdmin(branchId)
            || (isAuthenticated() && resource.data.userId == request.auth.uid);
          allow create: if isAuthenticated()
            && request.resource.data.userId == request.auth.uid
            && noPrivilegedStatus();
          allow update, delete: if isBranchAdmin(branchId);
        }
      }
    }

    // ── Collection-group aggregate (count) query access ──────────────────────
    // getCountFromServer(collectionGroup(...)) is evaluated at the query-plan
    // level where {branchId} is unbound; these wildcard rules (no path variables)
    // let admins run aggregate queries. Branch scoping is enforced at the query
    // level (where('branchId','==',…)). isActiveAdmin() uses no path variables, so
    // a DEACTIVATED admin (active:false) is denied here too — consistent with every
    // other admin gate in this ruleset.
    match /{path=**}/languageFormEntries/{entryId} {
      allow read: if isActiveAdmin();
    }
    match /{path=**}/trainingFormEntries/{entryId} {
      allow read: if isActiveAdmin();
    }

    // ── Deny everything else ──────────────────────────────────────────────────
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
